// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LogType {
  ADD
  DELETE
  UPDATE
  DOWNLOAD
  UPLOAD
  AUTH
}

model Log {
  id         Int      @id @default(autoincrement())
  type       LogType
  action     String
  userId     Int
  user       User     @relation(fields: [userId], references: [id])
  documentId Int?
  metadata   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model User {
  id                 Int                       @id @default(autoincrement())
  login              String                    @unique
  password           String
  memberId           Int?                      @unique
  member             TechnicalCommitteeMember? @relation(fields: [memberId], references: [id])
  logs               Log[]
  protectedDocuments ProtectedDocument[]
  discussions        InternalDiscussion[]      @relation("CreatedDiscussions")
  comments           DiscussionComment[]       @relation("CreatedComments")
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
}

model Executive {
  id           Int      @id @default(autoincrement())
  name         String
  position     String
  organization String
  experience   String?
  email        String   
  phone        String?
  address      String?
  biography    String?
  education    String?
  achievements String?
  awards       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model TechnicalCommitteeMember {
  id           Int      @id @default(autoincrement())
  name         String
  position     String
  organization String
  experience   String?
  email        String   
  phone        String?
  address      String?
  user         User?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model StandardFund {
  id           Int       @id @default(autoincrement())
  title        String
  description  String?
  approved     Boolean   @default(false)
  approvedAt   DateTime?
  organization String
  fileUrl      String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Protocol {
  id          Int      @id @default(autoincrement())
  title       String
  publishedAt DateTime @default(now())
  attachments String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AnnualReport {
  id              Int      @id @default(autoincrement())
  title           String
  publishedAt     DateTime @default(now())
  keyAchievements String
  fileUrl         String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

