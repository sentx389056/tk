// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  // output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ========== ПОЛЬЗОВАТЕЛЬ (для входа) ==========
// Связан только с Executive (руководством)
model User {
  id        Int      @id @default(autoincrement())
  login     String   @unique
  password  String   // хэш

  executive Executive @relation(fields: [executiveId], references: [id])
  executiveId Int    @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ========== РУКОВОДСТВО ==========
model Executive {
  id           Int      @id @default(autoincrement())
  name         String
  position     String
  organization String
  experience   String?
  email        String   @unique
  phone        String?
  address      String?

  biography    String?
  education    String?
  achievements String? // JSON
  awards       String? // JSON

  // Связь с User
  user         User?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ========== ЧЛЕН ТЕХНИЧЕСКОГО КОМИТЕТА (СОСТАВ ТК) ==========
model TechnicalCommitteeMember {
  id           Int      @id @default(autoincrement())
  name         String
  position     String
  organization String
  experience   String?
  email        String   @unique
  phone        String?
  address      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ========== ФОНД СТАНДАРТОВ ==========
model StandardFund {
  id            Int      @id @default(autoincrement())
  title         String
  description   String?
  approved      Boolean  @default(false)
  approvedAt    DateTime?
  organization  String
  fileUrl       String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ========== ПРОТОКОЛЫ ==========
model Protocol {
  id            Int      @id @default(autoincrement())
  title         String
  publishedAt   DateTime @default(now())
  attachments   String   // JSON

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ========== ГОДОВЫЕ ОТЧЁТЫ ==========
model AnnualReport {
  id               Int      @id @default(autoincrement())
  title            String
  publishedAt      DateTime @default(now())
  keyAchievements  String   // JSON
  fileUrl          String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ========== ПОЛОЖЕНИЯ О ТЕХНИЧЕСКИХ КОМИТЕТАХ ==========
model TechnicalCommitteeRegulation {
  id           Int      @id @default(autoincrement())
  title        String
  description  String?
  approvedAt   DateTime
  organization String
  fileUrl      String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ========== ПРОЕКТЫ СТАНДАРТОВ ==========
model StandardProject {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime?
  fileUrl     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ========== ЗАСЕДАНИЯ ==========
model Meeting {
  id            Int      @id @default(autoincrement())
  title         String
  publishedAt   DateTime @default(now())
  format        String
  location      String
  attachments   String   // JSON

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}