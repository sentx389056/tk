model TechnicalCommitteeRegulation {
  id           Int      @id @default(autoincrement())
  title        String
  description  String?
  approvedAt   DateTime
  organization String
  fileUrl      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model StandardProject {
  id          Int       @id @default(autoincrement())
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime?
  fileUrl     String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Meeting {
  id          Int      @id @default(autoincrement())
  title       String
  publishedAt DateTime @default(now())
  format      String
  location    String
  attachments String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProtectedDocument {
  id              Int      @id @default(autoincrement())
  title           String
  description     String?
  filePath        String // server-side path to file (not public)
  fileName        String
  copyrightHolder String?
  createdBy       Int?
  createdByUser   User?    @relation(fields: [createdBy], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model InternalDiscussion {
  id          Int       @id @default(autoincrement())
  title       String
  content     String    @db.Text
  status      String    @default("open") // open, closed
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   Int?
  createdByUser User?   @relation("CreatedDiscussions", fields: [createdBy], references: [id])
  comments    DiscussionComment[]
}

model DiscussionComment {
  id          Int       @id @default(autoincrement())
  content     String    @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  discussionId Int
  discussion  InternalDiscussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  createdBy   Int?
  createdByUser User?   @relation("CreatedComments", fields: [createdBy], references: [id])
}
