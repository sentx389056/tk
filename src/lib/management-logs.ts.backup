import { prisma } from './prisma';

// Используем локальное определение типа
type LogType = 'LOGIN' | 'LOGOUT' | 'CREATE' | 'UPDATE' | 'DELETE' | 'VIEW' | 'DOWNLOAD' | 'UPLOAD' | 'ERROR' | 'OTHER';

export interface LogEventOptions {
    userId: number;
    type: LogType;
    entity: string;
    entityId?: string;
    details?: string;
    ip?: string;
    userAgent?: string;
}

export async function logEvent(options: LogEventOptions) {
    try {
        await prisma.log.create({
            data: {
                userId: options.userId,
                type: options.type,
                entity: options.entity,
                entityId: options.entityId,
                details: options.details,
                ip: options.ip,
                userAgent: options.userAgent,
                createdAt: new Date(),
            },
        });
        return true;
    } catch (error) {
        console.error('Failed to log event:', error);
        return false;
    }
}

export async function getUserLogs(userId: number, limit: number = 50) {
    try {
        return await prisma.log.findMany({
            where: { userId },
            orderBy: { createdAt: 'desc' },
            take: limit,
            include: {
                user: {
                    select: {
                        id: true,
                        email: true,
                        name: true,
                    },
                },
            },
        });
    } catch (error) {
        console.error('Failed to fetch user logs:', error);
        return [];
    }
}

export async function getAllLogs(limit: number = 100) {
    try {
        return await prisma.log.findMany({
            orderBy: { createdAt: 'desc' },
            take: limit,
            include: {
                user: {
                    select: {
                        id: true,
                        email: true,
                        name: true,
                    },
                },
            },
        });
    } catch (error) {
        console.error('Failed to fetch all logs:', error);
        return [];
    }
}
